# Public repository allowlist
# Keep GitHub limited to application source, maintained tooling, deterministic
# tests/fixtures, the root README, Gradle essentials, and sanitized setup
# templates.
/*
!/.gitignore
!/.gitattributes
!/CHANGELOG.md
!/LICENSE
!/README.md
!/RELEASE_2.5.md
!/RELEASE_2.5_REDDIT.md
!/SOURCE_SHA256SUMS.txt
!/docs/
/docs/*
!/docs/Y2PLAYER_V2_3_RELEASE_POST.md
!/docs/Y2PLAYER_V2_3_REDDIT_POST.md
!/app/
# Maintained build, firmware, ADB, and regression tooling is source. Downloads,
# generated corpora, and other outputs stay under ignored build/out/dist paths.
!/tools/
/tools/media/corpus/
!/third_party/
/third_party/*
!/third_party/android-ndk-r25c.properties
!/third_party/ffmpeg/
/third_party/ffmpeg/*
!/third_party/ffmpeg/README.md
!/third_party/ffmpeg/source.properties
!/gradle/
!/gradlew
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/keystore.properties.example
!/local.properties.example
