avformat: allow metadata probes to skip attached-picture payloads

Y2Player scans libraries on a low-memory Android 4.4 device.  Its metadata
pass only needs to know whether cover art exists; copying compressed artwork
into AVPacket buffers during every scan wastes RAM and can make a malicious
picture block bypass the caller's probe-byte budget.

Add an opt-in AVFormatContext flag used by Y2Player's private static build.
Demuxers still identify picture entries and expose an attached-picture stream,
but the packet is left empty.  A later, explicitly requested artwork probe
leaves the flag clear and retains normal FFmpeg behaviour.

The Vorbis-comment and ID3 paths need early exits because they otherwise
allocate/base64-decode the complete picture before ff_add_attached_pic().  FLAC
also needs to skip its picture block before allocating a block-sized buffer.

FFmpeg's dictionary ID3 reader historically passed a NULL AVFormatContext to
the frame readers.  Carry the owning context through that internal API so APIC
parsing can safely inspect the opt-in limits before allocating the picture.

Applies to: ffmpeg-8.1.2
--- a/libavformat/avformat.h
+++ b/libavformat/avformat.h
@@ -1884,6 +1884,24 @@ typedef struct AVFormatContext {
      */
     int64_t duration_probesize;
 
+    /**
+     * Skip attached-picture payloads while retaining an empty attached-picture
+     * stream so callers can detect their presence. This is an opt-in demuxing
+     * optimisation for metadata-only inspection.
+     *
+     * Demuxing only, set by the caller before avformat_open_input().
+     */
+    int skip_attached_picture_payloads;
+
+    /**
+     * Maximum compressed attached-picture size to retain, or zero for FFmpeg's
+     * normal unlimited behaviour. Oversized pictures remain detectable but
+     * their payload is skipped.
+     *
+     * Demuxing only, set by the caller before avformat_open_input().
+     */
+    int64_t max_attached_picture_payload_size;
+
     /**
      * Name of this format context, only used for logging purposes.
      */
--- a/libavformat/demux_utils.c
+++ b/libavformat/demux_utils.c
@@ -114,6 +114,28 @@ int ff_add_attached_pic(AVFormatContext *s, AVStream *st0, AVIOContext *pb,
     if (!st && !(st = avformat_new_stream(s, NULL)))
         return AVERROR(ENOMEM);
     pkt = &st->attached_pic;
+    if (s->skip_attached_picture_payloads ||
+        (s->max_attached_picture_payload_size > 0 &&
+         ((buf && *buf && (*buf)->size > AV_INPUT_BUFFER_PADDING_SIZE &&
+                         (*buf)->size - AV_INPUT_BUFFER_PADDING_SIZE >
+                         s->max_attached_picture_payload_size) ||
+          (!buf && size > s->max_attached_picture_payload_size)))) {
+        av_packet_unref(pkt);
+        if (buf) {
+            av_buffer_unref(buf);
+        } else if (pb && size > 0) {
+            int64_t skip_result = avio_skip(pb, size);
+            if (skip_result < 0) {
+                ret = (int) skip_result;
+                goto fail;
+            }
+        }
+        st->disposition          |= AV_DISPOSITION_ATTACHED_PIC;
+        st->codecpar->codec_type  = AVMEDIA_TYPE_VIDEO;
+        pkt->stream_index         = st->index;
+        pkt->flags               |= AV_PKT_FLAG_KEY;
+        return 0;
+    }
     if (buf) {
         av_assert1(*buf);
         av_packet_unref(pkt);
